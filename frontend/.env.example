# WebRTC ICE 서버 설정
# 실제 값은 .env.local에 작성하고, 절대 커밋하지 않음

# 자체 STUN/TURN 서버 호스트 (예: turn.example.com:3478)
VITE_RTC_STUN_URL=stun:stun.example.com:3478
VITE_RTC_TURN_URL=turn:turn.example.com:3478

# TURN 서버 자격증명
VITE_RTC_TURN_USERNAME=your-turn-username
VITE_RTC_TURN_CREDENTIAL=your-turn-credential
